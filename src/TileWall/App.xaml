<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TileWall.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TileWall">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/ProductStrings.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- App-drawn chrome has one fixed Win10 geometry. Embedded wall previews
                 override their tile geometry locally through the shared wall renderer. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileWallPageBrush" Color="#202020" />
                    <SolidColorBrush x:Key="TileWallSurfaceBrush" Color="#292929" />
                    <SolidColorBrush x:Key="TileWallStrokeBrush" Color="#707070" />
                    <SolidColorBrush x:Key="TileWallSecondaryTextBrush" Color="#C6C6C6" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#383838" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#484848" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#606060" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#808080" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B0B0B0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileWallPageBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="TileWallSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TileWallStrokeBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TileWallSecondaryTextBrush" Color="#595959" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D3D3D3" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#BEBEBE" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#404040" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TileWallPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TileWallSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TileWallStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TileWallSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ContentDialogCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="TextControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ComboBoxCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="MenuFlyoutPresenterCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="MenuFlyoutItemCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="FlyoutPresenterCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ToolTipCornerRadius">0</CornerRadius>
            <x:Double x:Key="ContentControlFontSize">14</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
            <x:Double x:Key="ComboBoxMinHeight">32</x:Double>
            <Thickness x:Key="ContentDialogPadding">24</Thickness>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="RepeatButton">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="TileWallDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="ContentDialog">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{ThemeResource TileWallPageBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TileWallStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource TileWallDialogPrimaryButtonStyle}" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="Background" Value="{ThemeResource TileWallPageBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TileWallStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="MenuFlyoutItem">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style TargetType="ToggleMenuFlyoutItem">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="{ThemeResource TileWallPageBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TileWallStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
