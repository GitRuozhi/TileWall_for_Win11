<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TileWall.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TileWall.Views"
    Title="TileWall">
    <Grid x:Name="WallRoot" Background="Transparent" AutomationProperties.AutomationId="wall-root">
        <Grid.Resources>
            <Style x:Key="ResizeHotZone" TargetType="Thumb">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <views:WallSurface x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />
        <Thumb x:Name="ResizeHorizontalEdge" Height="8" Style="{StaticResource ResizeHotZone}"
               HorizontalAlignment="Stretch" VerticalAlignment="Top" Tag="Vertical"
               AutomationProperties.AutomationId="wall-resize-horizontal-edge"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb x:Name="ResizeVerticalEdge" Width="8" Style="{StaticResource ResizeHotZone}"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Tag="Horizontal"
               AutomationProperties.AutomationId="wall-resize-vertical-edge"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb x:Name="ResizeGrip" Width="14" Height="14" Style="{StaticResource ResizeHotZone}"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               AutomationProperties.AutomationId="wall-resize-grip"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Border x:Name="StatusPanel" Background="#DC263445" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Padding="8,5">
            <StackPanel Spacing="4">
                <TextBlock x:Name="StatusText" Foreground="White" TextWrapping="Wrap" />
                <Button x:Name="RetryViewButton" Content="从已保存状态重建墙面"
                        Visibility="Collapsed" Click="OnRetryViewClicked" />
                <Button x:Name="AdaptationButton" Visibility="Collapsed" Click="OnAdaptationClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
