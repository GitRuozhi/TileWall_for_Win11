<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap com desktop desktop4 desktop5 desktop6 virtualization rescap">

  <!--
    正式商店身份来自 Partner Center。Name、Publisher 与 Application Id 发布后保持稳定。
    包版本由 tools/build.ps1 从产品版本派生；本地侧载证书必须匹配正式 Publisher。
  -->
  <Identity
    Name="Ruozhi.TileWall"
    Publisher="CN=E85F876C-CE51-47F1-A1F6-9007A3C15A22"
    Version="1.4.2.0" />

  <mp:PhoneIdentity PhoneProductId="1A027D37-1D32-492F-ACD2-E456FB4E670C" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>TileWall</DisplayName>
    <PublisherDisplayName>Ruozhi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- 1903+ retains shared AppData writes; newer systems prefer the directory-scoped declaration. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\TileWall</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- 仅 Desktop（模板的 Windows.Universal 条目删除；WindowsAppSDK 桌面应用无跨设备语义）。
         MinVersion 18362 与 TargetPlatformMinVersion 一致，覆盖共享 AppData 声明的 1903 下限。 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="TileWall"
        Description="TileWall tile launcher"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- One native Explorer command uses the system COM surrogate and package activation. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="TileWall.exe" Arguments="----AppNotificationActivated:" DisplayName="TileWall">
              <com:Class Id="de9c314c-7f05-4c18-88c2-0239a01315b8" />
            </com:ExeServer>
            <com:SurrogateServer DisplayName="TileWall Explorer Command">
              <com:Class Id="cb391e98-9cf2-4a54-abea-fbc529ca2d44"
                         Path="TileWall.ExplorerExtension.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="de9c314c-7f05-4c18-88c2-0239a01315b8" />
        </desktop:Extension>
        <!-- (2) Explorer 右键「添加到 TileWall」：文件/程序/快捷方式（Type="*"）与文件夹（Type="Directory"）。
             文件项用 desktop4:ItemType（min OS 1803；Type 仅允许 */.ext）；文件夹项必须用 desktop5:ItemType
             （ST_FileTypeOrStarWithDirectory 才含 Directory；min OS 1809=17763，由清单 MinVersion 覆盖；其父元素
             desktop4:FileExplorerContextMenus 官方 schema 允许 desktop5:ItemType 子元素）。
             实测：desktop4:ItemType Type="Directory" 被 MakeAppx 拒（C00CE169 pattern 校验失败）。 -->
        <!-- IExplorerCommand supplies Win10 classic and Win11 modern/classic menus.
             A parallel desktop9 IContextMenu registration duplicates the Win11 classic item. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop4:ItemType Type="*">
              <desktop4:Verb Id="AddToTileWall" Clsid="cb391e98-9cf2-4a54-abea-fbc529ca2d44" />
            </desktop4:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="AddToTileWall" Clsid="cb391e98-9cf2-4a54-abea-fbc529ca2d44" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <!-- (3) packaged 登录启动（M9 设计 §5.1）：替代 Run 键——版本化 WindowsApps 路径升级即失效、卸载即残留；
             StartupTask 由系统随卸载自动回收，零残留。TaskId 与 StartupTaskLoginStartup.TaskId 一致。 -->
        <desktop:Extension Category="windows.startupTask" Executable="TileWall.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TileWallLoginStartup" Enabled="false" DisplayName="TileWall" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- 模板的 systemai:Capability Name="systemAIModels" 删除：产品无 AI 能力消费，缩小清单校验面（S2 冒烟验证） -->
  </Capabilities>
</Package>
