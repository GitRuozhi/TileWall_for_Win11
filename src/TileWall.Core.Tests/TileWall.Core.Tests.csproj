<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWinUI>false</UseWinUI>
    <!-- D2（F-06）：测试工程与 Core 同级纪律（含 xUnit 分析器警告，如 xUnit2013） -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TileWall.Core\TileWall.Core.csproj" />
    <Compile Include="..\TileWall\Application\WallSession.cs" Link="Application\WallSession.cs" />
    <Compile Include="..\TileWall\Application\ExitDraftSavePermission.cs" Link="Application\ExitDraftSavePermission.cs" />
    <Compile Include="..\TileWall\Application\StartMenuImportCandidate.cs" Link="Application\StartMenuImportCandidate.cs" />
    <Compile Include="..\TileWall\Application\StartMenuImportPreparation.cs" Link="Application\StartMenuImportPreparation.cs" />
    <Compile Include="..\TileWall\Shell\EntryLauncher.cs" Link="Shell\EntryLauncher.cs" />
    <Compile Include="..\TileWall\Graphics\PartitionTransitionTiming.cs" Link="Graphics\PartitionTransitionTiming.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
