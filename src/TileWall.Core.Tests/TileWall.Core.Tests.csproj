<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWinUI>false</UseWinUI>
    <!-- D2（F-06）：测试工程与 Core 同级纪律（含 xUnit 分析器警告，如 xUnit2013） -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TileWall.Core\TileWall.Core.csproj" />
    <Compile Include="..\TileWall\Graphics\ManagedImageCache.cs" Link="Graphics\ManagedImageCache.cs" />
    <Compile Include="..\TileWall\Graphics\BoundedOriginalFileRead.cs" Link="Graphics\BoundedOriginalFileRead.cs" />
    <Compile Include="..\TileWall\Application\FullscreenResizeGesture.cs" Link="Application\FullscreenResizeGesture.cs" />
    <Compile Include="..\TileWall\Shell\Interop\ExplorerContextMenuRegistration.cs" Link="Shell\ExplorerContextMenuRegistration.cs" />
    <Compile Include="..\TileWall\Application\ContextMenuUserCommand.cs" Link="Application\ContextMenuUserCommand.cs" />
    <Compile Include="..\TileWall\Application\CurrentUserUninstallCommand.cs" Link="Application\CurrentUserUninstallCommand.cs" />
    <Compile Include="..\TileWall\Shell\Interop\DesktopUserUninstallLauncher.cs" Link="Shell\DesktopUserUninstallLauncher.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\Compatibility\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Snapshots\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
